<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect HTTP to HTTPS (для работы за прокси)
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Redirect ilat.info/exam -> exam.ilat.info (как для exam2)
  RewriteRule ^exam/?$ https://exam.ilat.info/ [R=301,L]

  # If the requested resource is not a file or directory, serve index.html (SPA routing)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # X-Frame-Options не используем: блокирует селектор целей и inpage-аналитику Метрики.
  # Вместо этого ограничиваем встраивание через frame-ancestors в CSP (см. ниже).
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self' https://metrika.yandex.ru https://metrika.yandex.by https://metrika.yandex.com https://metrika.yandex.com.tr https://metrika.yandex.kz https://metrika.yandex.uz https://metrica.yandex.ru https://metrica.yandex.by https://metrica.yandex.com https://metrica.yandex.com.tr https://metrica.yandex.kz https://analytics.yandex.ru https://analytics.yandex.by https://analytics.yandex.com https://webvisor.com https://*.webvisor.com https://mc.yandex.ru; img-src 'self' data: https: https://www.facebook.com; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://mc.yandex.ru https://yastatic.net https://www.googletagmanager.com https://connect.facebook.net; connect-src 'self' https://mc.yandex.ru https://*.yandex.ru https://*.yandex.net https://api.bepaid.by https://dogovor.by https://exam.ilat.info https://exam2.ilat.info https://www.google-analytics.com https://www.googletagmanager.com https://www.facebook.com; frame-src blob: https://mc.yandex.ru https://mc.webvisor.com https://api.bepaid.by https://dogovor.by; child-src blob: https://mc.yandex.ru; form-action 'self'; upgrade-insecure-requests"

  # Cache static assets for 1 year
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # No cache for HTML (always serve fresh)
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
